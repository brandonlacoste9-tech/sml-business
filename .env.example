# KimiClaw Business OS Configuration

# Business Information
BUSINESS_NAME="Your Business Name"
BUSINESS_INDUSTRY="plumbing"  # plumbing, electrical, hvac, landscaping, cleaning, general
BUSINESS_LANGUAGE="en"  # en, fr, bilingual
BUSINESS_PHONE="+15555551234"
BUSINESS_WHATSAPP="+15555551234"

# Operating Hours
BUSINESS_HOURS_START="08:00"
BUSINESS_HOURS_END="17:00"
BUSINESS_TIMEZONE="America/Toronto"

# Capacity & Mode Settings
WEEKLY_CAPACITY=40  # hours per week
HUNTER_MODE_THRESHOLD=0.6  # 60% capacity
SURGE_MODE_THRESHOLD=0.9  # 90% capacity

# Database
DATABASE_URL="postgresql://kimiclaw:password@localhost:5432/kimiclaw"
REDIS_URL="redis://localhost:6379/0"

# Ollama
OLLAMA_HOST="http://localhost:11434"
OLLAMA_CONVERSATION_MODEL="llama3.2"
OLLAMA_REASONING_MODEL="mistral"
OLLAMA_VISION_MODEL="llava:13b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Google
GOOGLE_CREDENTIALS_PATH="credentials/google-credentials.json"
GOOGLE_CALENDAR_ID=""
GOOGLE_GMAIL_ADDRESS=""

# Lead Generation
SERPAPI_KEY=""
LEAD_HUNT_SCHEDULE="0 8 * * *"  # Daily at 8am
LEAD_SCORE_THRESHOLD=70

# Advertising
AD_SCHEDULE_MORNING="0 9 * * *"  # Daily at 9am
AD_SCHEDULE_AFTERNOON="0 15 * * *"  # Daily at 3pm

# Financial
STRIPE_API_KEY=""
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""

# System Mode
SYSTEM_MODE="lite"  # lite or full (auto-detected based on RAM)
AUTO_SEND_EMAILS=false  # Queue for review if false
EMERGENCY_KEYWORDS="flood,fire,sparks,no heat,gas leak,urgent"

# Webhook URL (for deployment)
WEBHOOK_BASE_URL="http://localhost:8000"

# Logging
LOG_LEVEL="INFO"
